# Use Alpaca PAPER account credentials only.
AEGIS_ALPACA_API_KEY=
AEGIS_ALPACA_SECRET_KEY=

AEGIS_SYMBOL=TQQQ
AEGIS_DATABASE_PATH=data/aegis.db
AEGIS_POLL_SECONDS=20
AEGIS_LOG_LEVEL=INFO

# 0.0025 = 0.25% of current equity risked per planned trade.
AEGIS_RISK_PER_TRADE_PCT=0.0025
AEGIS_MAX_DAILY_LOSS_PCT=0.01
AEGIS_MAX_POSITION_NOTIONAL_PCT=0.25
AEGIS_MAX_TRADES_PER_DAY=3
AEGIS_REWARD_TO_RISK=2.0

AEGIS_VOLUME_FACTOR=1.20
AEGIS_MAX_EXTENSION_PCT=0.004
AEGIS_MAX_STOP_PCT=0.0125
AEGIS_MAX_SPREAD_BPS=20
AEGIS_QUOTE_MAX_AGE_SECONDS=30

# MCP: stdio, streamable-http, or sse
AEGIS_MCP_TRANSPORT=stdio
AEGIS_MCP_HOST=127.0.0.1
AEGIS_MCP_PORT=8765
