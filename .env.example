AEGIS_EXECUTION_MODE=simulation
AEGIS_SYMBOL=TQQQ
AEGIS_DATABASE_PATH=data/aegis.db
AEGIS_STARTING_CASH=10000

# Schwab read/shadow access only in v0.2.
# Never commit actual credentials or tokens.
AEGIS_SCHWAB_CLIENT_ID=
AEGIS_SCHWAB_CLIENT_SECRET=
AEGIS_SCHWAB_REDIRECT_URI=https://127.0.0.1
AEGIS_SCHWAB_ACCESS_TOKEN=
AEGIS_SCHWAB_ACCOUNT_HASH=

# Live mode remains nonfunctional even when these are supplied.
AEGIS_COMPLIANCE_APPROVED=false
AEGIS_LIVE_TRADING_ACK=
